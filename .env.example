# Which parser answers /api/parse: anthropic | openai | offline.
# Leave unset to pick the first provider with a key (Anthropic, then OpenAI), else offline.
LLM_PROVIDER=

# Anthropic (Claude). Model defaults to claude-opus-5-5 when unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI. OPENAI_MODEL is required when the provider is openai; there is no default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Public demo caps for LLM parses (in-memory, per instance).
DEMO_LIMIT_PER_IP_PER_HOUR=20
DEMO_LIMIT_GLOBAL_PER_DAY=1000

# Give up on the LLM and use the offline parser after this many milliseconds.
PARSE_TIMEOUT_MS=10000
